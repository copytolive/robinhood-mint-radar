<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.copytolive.robinhood-mint-radar</string>
<key>ProgramArguments</key><array><string>/bin/sh</string><string>REPLACE_WITH_REPO_PATH/run-local.sh</string></array>
<key>WorkingDirectory</key><string>REPLACE_WITH_REPO_PATH</string>
<key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
<key>StandardOutPath</key><string>/tmp/robinhood-mint-radar.out.log</string>
<key>StandardErrorPath</key><string>/tmp/robinhood-mint-radar.err.log</string>
</dict></plist>
