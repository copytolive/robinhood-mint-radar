# READ-ONLY ONLY. Never put a wallet private key or seed phrase here.
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RADAR_SCAN_INTERVAL=15
RADAR_INITIAL_LOOKBACK_BLOCKS=120
RADAR_CHUNK_BLOCKS=60
RADAR_CONFIRMATION_BLOCKS=10
RADAR_REORG_REWIND_BLOCKS=120
RADAR_MAX_CANDIDATES=20
RADAR_OBSERVATION_RETENTION_DAYS=30
RADAR_EVENT_RETENTION_DAYS=90
RADAR_BACKUP_INTERVAL_SECONDS=86400
RADAR_BACKUP_KEEP=7
RADAR_DASHBOARD_PORT=4173
RADAR_MAC_NOTIFICATIONS=1

# Optional enrichment. The scanner does NOT require this for observed on-chain
# Seaport/Hoodsea sales, but floor/orderbook enrichment still benefits from it.
OPENSEA_API_KEY=
OPENSEA_CHAIN=robinhood
