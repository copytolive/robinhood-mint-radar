# READ-ONLY ONLY. Never put a wallet private key or seed phrase here.
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Optional override. Leave unset to use the built-in chain-verified public
# failovers when the official Robinhood RPC resets or rate-limits.
# RH_RPC_FALLBACK_URLS=https://robinhood-mainnet-rpc.blockreq.com/v1/rpc/public,https://rpc.nodeflare.app/robinhood/public
RADAR_SCAN_INTERVAL=15
RADAR_CYCLE_TIMEOUT_SECONDS=90
RADAR_INITIAL_LOOKBACK_BLOCKS=120
RADAR_CHUNK_BLOCKS=5000
RADAR_MAX_CATCHUP_BLOCKS=5000
# Bound one cycle's ingest wall clock so the child can publish status before the
# 90-second supervisor deadline. Blocks beyond the frozen target are deferred.
RADAR_INGEST_CYCLE_BUDGET_SECONDS=55
# After a long network/DNS outage, resume live instead of replaying a backlog
# that cannot converge inside the 90s watchdog. Skipped blocks are recorded as
# historical gaps and are never treated as already analyzed.
RADAR_RUNTIME_REBASE_LAG_BLOCKS=5000
RADAR_MAX_READY_LAG_BLOCKS=2000
RADAR_MAX_READY_LAG_SECONDS=60
RADAR_CONFIRMATION_BLOCKS=10
RADAR_REORG_REWIND_BLOCKS=120
RADAR_MAX_CANDIDATES=20
RADAR_MAX_ANALYSIS_ROWS=4
RADAR_OBSERVATION_RETENTION_DAYS=30
RADAR_EVENT_RETENTION_DAYS=90
RADAR_BACKUP_INTERVAL_SECONDS=86400
RADAR_BACKUP_KEEP=7
RADAR_DASHBOARD_PORT=4173
RADAR_MAC_NOTIFICATIONS=1

# Optional enrichment. The scanner does NOT require this for observed on-chain
# Seaport/Hoodsea sales, but floor/orderbook enrichment still benefits from it.
OPENSEA_API_KEY=
OPENSEA_CHAIN=robinhood
